{
  "name": "szigzug",
  "version": "1.0.0",
  "description": "Website and admin panel of the jubilee points competition (szigzug.hu)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "coverage": "node --disable-warning=ExperimentalWarning --test --experimental-test-coverage \"test/**/*.test.js\"",
    "users": "node --disable-warning=ExperimentalWarning bin/users.js",
    "backup": "node --disable-warning=ExperimentalWarning bin/backup.js"
  }
}
