# Copy to /etc/szigzug/szigzug.env on the server (deploy/README.md, step 3).
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DB_PATH=/var/lib/szigzug/szigzug.db
# nginx on the same machine passes the visitor's IP address.
TRUST_PROXY=1
# Cookies only over HTTPS. Set to 0 ONLY while testing before HTTPS works, then back to 1.
COOKIE_SECURE=1
